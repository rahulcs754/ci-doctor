{
  "name": "ci-doctor",
  "version": "0.1.0",
  "description": "Find slow, costly and failing GitHub Actions workflows and open a PR with YAML fixes",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulcs754/ci-doctor.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rahulcs754/ci-doctor/issues"
  },
  "homepage": "https://github.com/rahulcs754/ci-doctor#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "@octokit/rest": "^21.1.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true,
  "bin": {
    "ci-doctor": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  }
}
